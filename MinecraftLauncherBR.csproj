<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MinecraftLauncherBR</AssemblyName>
    <RootNamespace>MinecraftLauncherBR</RootNamespace>
    <Product>MinecraftLauncherBR</Product>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- ===== Avalonia UI (interface gráfica multiplataforma) ===== -->
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <!-- ===== MVVM (ObservableObject / RelayCommand) ===== -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- ===== CmlLib.Core: baixa versões oficiais, bibliotecas, assets, natives e inicia o jogo ===== -->
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />

    <!-- ===== Login real com conta Microsoft/Xbox (necessário para jogar online) ===== -->
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.2.2" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.0" />
  </ItemGroup>

</Project>
